#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    int i0, i1, i2, i3, i4, i5, i6, i7;
    float f0, f1, f2, f3;
} pc;

layout(binding = 0) uniform textureBuffer WTex;
layout(std430, binding = 1) readonly buffer XBuf { float X[]; };
layout(std430, binding = 2) buffer YBuf { float Y[]; };

shared float red[64];

void main() {
    uint n_tok = uint(pc.i0), n_out = uint(pc.i1), n_in = uint(pc.i2);
    uint accf = uint(pc.i3);
    uint row0 = gl_WorkGroupID.x * 8u;
    uint t = gl_WorkGroupID.y;
    if (t >= n_tok) return;
    uint lid = gl_LocalInvocationID.x;
    uint xbase = t * n_in;
    float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
    float a4 = 0.0, a5 = 0.0, a6 = 0.0, a7 = 0.0;
    for (uint j = lid * 4u; j < n_in; j += 256u) {
        float xv0 = X[xbase + j];
        float xv1 = X[xbase + j + 1u];
        float xv2 = X[xbase + j + 2u];
        float xv3 = X[xbase + j + 3u];
        uint i = row0;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a0 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 1u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a1 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 2u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a2 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 3u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a3 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 4u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a4 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 5u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a5 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 6u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a6 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
        i = row0 + 7u;
        if (i < n_out) {
            vec4 w = texelFetch(WTex, int((i * n_in + j) >> 2u));
            a7 += w.x * xv0 + w.y * xv1 + w.z * xv2 + w.w * xv3;
        }
    }
    float accs[8] = float[](a0, a1, a2, a3, a4, a5, a6, a7);
    for (uint r = 0u; r < 8u; r++) {
        red[lid] = accs[r];
        barrier();
        for (uint off = 32u; off > 0u; off >>= 1u) {
            if (lid < off) red[lid] += red[lid + off];
            barrier();
        }
        uint i = row0 + r;
        if (lid == 0u && i < n_out) {
            uint yi = t * n_out + i;
            Y[yi] = (accf != 0u) ? Y[yi] + red[0] : red[0];
        }
        barrier();
    }
}
