#version 450
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    int i0, i1, i2, i3, i4, i5, i6, i7;
    float f0, f1, f2, f3;
} pc;

layout(std430, binding = 0) readonly buffer XBuf { float X[]; };
layout(std430, binding = 1) readonly buffer WBuf { float Weight[]; };
layout(std430, binding = 2) buffer YBuf { float Y[]; };

shared float red[64];

void main() {
    uint n = uint(pc.i0), n_tok = uint(pc.i1);
    uint t = gl_WorkGroupID.x;
    if (t >= n_tok) return;
    uint lid = gl_LocalInvocationID.x;
    uint base = t * n;
    float ss = 0.0;
    for (uint i = lid; i < n; i += 64u) {
        float v = X[base + i];
        ss += v * v;
    }
    red[lid] = ss;
    barrier();
    for (uint off = 32u; off > 0u; off >>= 1u) {
        if (lid < off) red[lid] += red[lid + off];
        barrier();
    }
    float inv = inversesqrt(red[0] / float(n) + pc.f0);
    barrier();
    for (uint i = lid; i < n; i += 64u)
        Y[base + i] = X[base + i] * inv * Weight[i];
}
