#version 450
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    int i0, i1, i2, i3, i4, i5, i6, i7;
    float f0, f1, f2, f3;
} pc;

layout(std430, binding = 0) readonly buffer TabBuf { float Tab[]; };
layout(std430, binding = 1) readonly buffer IdBuf { int Ids[]; };
layout(std430, binding = 2) buffer OutBuf { float Out[]; };

void main() {
    uint n_rows = uint(pc.i0), d = uint(pc.i1);
    uint stride = gl_NumWorkGroups.x * 64u;
    uint idx = gl_GlobalInvocationID.y * stride + gl_GlobalInvocationID.x;
    uint total = n_rows * d;
    if (idx >= total) return;
    uint j = idx % d;
    uint t = idx / d;
    int id = Ids[t];
    Out[idx] = Tab[uint(id) * d + j];
}
