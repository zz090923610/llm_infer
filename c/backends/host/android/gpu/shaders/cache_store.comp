#version 450
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    int i0, i1, i2, i3, i4, i5, i6, i7;
    float f0, f1, f2, f3;
} pc;

layout(std430, binding = 0) buffer CacheK { float CK[]; };
layout(std430, binding = 1) buffer CacheV { float CV[]; };
layout(std430, binding = 2) readonly buffer KBuf { float K[]; };
layout(std430, binding = 3) readonly buffer VBuf { float V[]; };
layout(std430, binding = 4) readonly buffer VLBuf { int VL[]; };
layout(std430, binding = 5) readonly buffer StBuf { int ST[]; };

void main() {
    uint B = uint(pc.i0), S = uint(pc.i1), H = uint(pc.i2), d = uint(pc.i3);
    uint batch_stride = uint(pc.i4), head_stride = uint(pc.i5);
    uint total = B * H * S * d;
    uint stride = gl_NumWorkGroups.x * 64u;
    uint idx = gl_GlobalInvocationID.y * stride + gl_GlobalInvocationID.x;
    if (idx >= total) return;
    uint di = idx % d;
    uint tmp = idx / d;
    uint t = tmp % S;
    tmp /= S;
    uint h = tmp % H;
    uint b = tmp / H;
    int n = VL[b];
    if (int(t) >= n) return;
    int s0 = ST[b];
    uint src = (((b * H + h) * S + t) * d) + di;
    uint dst = b * batch_stride + h * head_stride + uint(s0 + int(t)) * d + di;
    CK[dst] = K[src];
    CV[dst] = V[src];
}
